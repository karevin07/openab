# --- Build stage ---
FROM rust:1-bookworm AS builder
WORKDIR /build
ARG OPENAB_CARGO_FEATURES=discord
COPY Cargo.toml Cargo.lock ./
COPY crates/openab-core/Cargo.toml crates/openab-core/Cargo.toml
COPY crates/openab-gateway/Cargo.toml crates/openab-gateway/Cargo.toml
COPY crates/openab-mcp/Cargo.toml crates/openab-mcp/Cargo.toml
COPY crates/openab-cp/Cargo.toml crates/openab-cp/Cargo.toml
RUN mkdir -p src crates/openab-core/src crates/openab-gateway/src crates/openab-mcp/src crates/openab-cp/src \
    && echo 'fn main() {}' > src/main.rs \
    && echo '' > crates/openab-core/src/lib.rs \
    && echo '' > crates/openab-gateway/src/lib.rs \
    && echo '' > crates/openab-mcp/src/lib.rs \
    && echo '' > crates/openab-cp/src/lib.rs \
    && cargo build --release --no-default-features --features "${OPENAB_CARGO_FEATURES}" \
    && rm -rf src crates/openab-core/src crates/openab-gateway/src crates/openab-mcp/src crates/openab-cp/src
COPY crates/ crates/
COPY src/ src/
RUN touch src/main.rs crates/openab-core/src/lib.rs crates/openab-gateway/src/lib.rs crates/openab-mcp/src/lib.rs crates/openab-cp/src/lib.rs \
    && cargo build --release --no-default-features --features "${OPENAB_CARGO_FEATURES}" \
    && strip --strip-unneeded target/release/openab

# --- OpenCode install stage ---
# opencode is published to npm as `opencode-ai`; the npm package selects a
# platform-specific pre-compiled executable. Node is needed only to unpack the
# package, not at runtime.
#
# Version is pinned for reproducible builds.
# opencode releases very frequently (often daily); bump this version via
# a dedicated PR when a new release is needed.
#
# Note: opencode does not publish SHA256 checksums for its releases,
# so checksum verification is not possible at this time.
#
# Floor: 1.17.3. Earlier 1.16.x releases (and likely 1.15.x) ship an ACP
# regression where OpenRouter reasoning models (e.g. google/gemini-3-flash)
# never emit a final `agent_message_chunk` over ACP — opencode's internal
# session storage holds the assistant text part, but the ACP server only
# emits `usage_update` + `stopReason: end_turn`. From OpenAB's side this
# surfaces as `(no response)` because there is no message content to render.
# The upstream fix landed in 1.17.0 (sst/opencode#30332,
# "fix(opencode): generate reasoning variants for all OpenRouter models").
# 1.17.3 is the latest 1.17.x verified by users to recover correctly.
FROM node:22-trixie-slim AS opencode-installer

# Install opencode and keep only the executable for the runtime stage. Copying
# the whole npm tree retains both the platform package and postinstall copy.
ARG OPENCODE_VERSION=1.17.9
RUN npm install -g opencode-ai@${OPENCODE_VERSION} --retry 3 \
    && test "$(opencode --version)" = "${OPENCODE_VERSION}"

# --- Runtime stage ---
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git make openssh-client procps python3 ripgrep tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=opencode-installer --chmod=755 \
  /usr/local/lib/node_modules/opencode-ai/bin/opencode.exe /usr/local/bin/opencode

RUN mkdir -p /home/agent/.config/opencode /home/agent/.local/share/opencode \
    && useradd -d /home/agent -s /bin/bash -u 1000 agent \
    && chown -R agent:agent /home/agent

ENV HOME=/home/agent
WORKDIR /home/agent

COPY --from=builder --chown=agent:agent /build/target/release/openab /usr/local/bin/openab

USER agent
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD pgrep -x openab || exit 1
ENV OPENAB_AGENT_COMMAND="opencode acp"
ENV OPENAB_AGENT_AUTH_COMMAND="opencode auth login"

ENTRYPOINT ["tini", "--"]
CMD ["openab", "run", "-c", "/etc/openab/config.toml"]
